{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "vercel-static",
  "functions": {
    "api/market-pulse.js": { "includeFiles": "public/**", "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/market-pulse" },
    { "source": "/:path*", "destination": "/api/market-pulse?_mp_route=:path*" }
  ]
}
